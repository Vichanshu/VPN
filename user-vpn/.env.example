# Visitor app (user-vpn). Copy to .env.local for development; in production set
# these as environment variables in your host's dashboard. Never commit real values.

# --- Required -------------------------------------------------------------
# Same PostgreSQL database as the admin app (final-vpn), so the admin sees visitor scans.
# Tables are created automatically on first use.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Optional pooler URL; preferred over DATABASE_URL when set.
DATABASE_URL_POOLER=

# --- Hosting / client IP --------------------------------------------------
# vercel | cloudflare | generic. Leave unset locally. In production this MUST match
# your host, otherwise the visitor's IP cannot be trusted.
TRUSTED_PROXY_PROVIDER=vercel
# Required only when TRUSTED_PROXY_PROVIDER=generic.
TRUSTED_CLIENT_IP_HEADER=x-real-ip
# vercel (free edge headers) | maxmind | ipapi
IP_ENRICHMENT_PROVIDER=vercel
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# --- Secrets (use different random 32+ byte values per deployment) -------------
# Signs the per-visit challenge issued and checked by this app.
SCAN_SIGNING_SECRET=
# MUST be identical to the admin app's value so protected fingerprint components compare.
FINGERPRINT_HMAC_SECRET=
PROBE_SIGNING_SECRET=

# --- Detection tuning (match the admin app) ----------------------------------------
VPN_RISK_PRIOR=0.05
PUBLIC_IP_LISTS=true
TOR_EXIT_LOOKUP=true
LINKAGE_PRIOR=

# --- Optional IP intelligence -----------------------------------------------------------
IPINFO_TOKEN=
RIPE_ATLAS_KEY=
RIPE_ATLAS_PUBLIC_MEASUREMENTS=false
ATLAS_DAILY_LIMIT=20

# --- Optional network path probes -----------------------------------------------------
IPV4_PROBE_URL=
IPV6_PROBE_URL=
RESEARCH_APP_ORIGIN=
STUN_URL=
ALLOW_PUBLIC_STUN=true
JA4_HEADER_NAME=
HTTP_PROTOCOL_HEADER_NAME=
TCP_RTT_HEADER_NAME=
TCP_RTT_HEADER_UNIT=us
SERVER_LATITUDE=
SERVER_LONGITUDE=

# --- Local development only (used when no database URL is set) ---------------------------
RESEARCH_FILE_STORE=
IP_INTEL_FILE_STORE=
